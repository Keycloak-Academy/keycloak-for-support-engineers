# Base URL of your Keycloak instance — no trailing slash
KEYCLOAK_BASE_URL=http://localhost:8080

# Public base URL where this app is reachable — no trailing slash
# Must match the APP_BASE_URL_PLACEHOLDER you put in the realm export
APP_BASE_URL=http://localhost:3000

# Client secret for the web-app client (matches the realm export value)
WEB_APP_CLIENT_SECRET=web-app-secret-not-for-production

# Session cookie secret — change to a long random string in production
SESSION_SECRET=local-dev-secret-change-for-production

PORT=3000
